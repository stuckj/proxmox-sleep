#!/bin/bash
#
# Mock `pct` for the offline test harness. See mocks/qm for the conventions.
#
# `pct exec <id> -- sh -c '<script>'` actually *runs* the script locally with a
# stubbed `ps`, so the real in-container command in check_ct_gaming_processes —
# its PATH handling included — is exercised rather than short-circuited.

set -uo pipefail

mock_env() {
    local name="$1" def="${2:-}"
    if [[ -n "${!name+x}" ]]; then printf '%s' "${!name}"; else printf '%s' "$def"; fi
}

log_call() {
    [[ -n "${MOCK_CALL_LOG:-}" ]] && printf 'pct %s\n' "$*" >> "$MOCK_CALL_LOG"
    return 0
}

get_status() {
    # NB: separate statements — `local a=$1 b=$a` expands $a before it is set.
    local id="$1"
    local f="${MOCK_RUNTIME:-}/pct_status_$id"
    if [[ -f "$f" ]]; then cat "$f"; else mock_env "MOCK_PCT_STATUS_$id" stopped; fi
}

set_status() {
    [[ -n "${MOCK_RUNTIME:-}" ]] && printf '%s' "$2" > "$MOCK_RUNTIME/pct_status_$1"
    return 0
}

log_call "$@"

cmd="${1:-}"; shift || true

case "$cmd" in
    status)
        # Real `pct status` fails for an ID that does not exist; validate_config
        # relies on that, so the suite needs a way to express it.
        if [[ ",${MOCK_MISSING_IDS:-}," == *",${1:-},"* ]]; then
            echo "Configuration file 'nodes/test/lxc/${1:-}.conf' does not exist" >&2
            exit 2
        fi
        printf 'status: %s\n' "$(get_status "${1:-}")"
        ;;

    exec)
        id="${1:-}"; shift || true
        [[ "$(get_status "$id")" == "running" ]] || exit 1
        # Strip the leading `--` separator, then expect `sh -c <script>`.
        [[ "${1:-}" == "--" ]] && shift
        if [[ "${1:-}" == "sh" && "${2:-}" == "-c" ]]; then
            script="$3"
            # The simulated container's filesystem decides where `ps` lives:
            #   default                   on the PATH pct exec passes (Debian etc.)
            #   MOCK_CT_NIXOS_<id>=1      only under /run/current-system/sw/bin,
            #                             as on NixOS, whose /usr/bin and /bin
            #                             hold no ps
            #   MOCK_CT_NO_PS_<id>=1      nowhere
            # Nothing outside the container is reachable in the last two, so the
            # system profile path is pointed at the stub (or at nothing) and the
            # inherited PATH at a directory that does not exist.
            ct_path="${MOCK_BIN_DIR:-}:$PATH"
            if [[ "$(mock_env "MOCK_CT_NIXOS_$id" 0)" == "1" ]]; then
                ct_path="/nonexistent-ct-bin"
                script="${script//\/run\/current-system\/sw\/bin/${MOCK_BIN_DIR:-}}"
            elif [[ "$(mock_env "MOCK_CT_NO_PS_$id" 0)" == "1" ]]; then
                ct_path="/nonexistent-ct-bin"
                script="${script//\/run\/current-system\/sw\/bin//nonexistent-ct-profile}"
            fi
            MOCK_PS_OUTPUT="$(mock_env "MOCK_CT_PS_$id" "")" \
                PATH="$ct_path" "$BASH" -c "$script"
            exit $?
        fi
        exit 0
        ;;

    shutdown)
        id="${1:-}"
        # MOCK_PCT_SHUTDOWN_HANG_<id>=1: never returns, as a real shutdown task does
        # when the guest is stuck in the kernel. `sleep` is mocked, so block on tail.
        [[ "$(mock_env "MOCK_PCT_SHUTDOWN_HANG_$id" 0)" == "1" ]] && exec tail -f /dev/null
        rc=$(mock_env "MOCK_PCT_SHUTDOWN_RC_$id" 0)
        [[ "$rc" == "0" ]] && set_status "$id" stopped
        exit "$rc"
        ;;

    stop)
        id="${1:-}"
        [[ "$(mock_env "MOCK_PCT_STOP_HANG_$id" 0)" == "1" ]] && exec tail -f /dev/null
        set_status "$id" stopped
        exit "$(mock_env "MOCK_PCT_STOP_RC_$id" 0)"
        ;;

    start)
        id="${1:-}"
        rc=$(mock_env "MOCK_PCT_START_RC_$id" 0)
        [[ "$rc" == "0" ]] && set_status "$id" running
        exit "$rc"
        ;;

    *)
        exit 0
        ;;
esac
