#!/bin/bash
#
# Mock `ps` used *inside* the simulated container (see mocks/pct exec).
# Emits $MOCK_PS_OUTPUT verbatim for `ps -eo args=`, which lets the harness
# feed full command lines (with paths and arguments) through the real
# awk + basename pipeline under test.

set -uo pipefail

for arg in "$@"; do
    if [[ "$arg" == "-eo" || "$arg" == "args=" || "$arg" == "-eoargs=" ]]; then
        printf '%s\n' "${MOCK_PS_OUTPUT:-}"
        exit 0
    fi
done

printf '%s\n' "${MOCK_PS_OUTPUT:-}"
