#!/bin/bash
#
# Mock `qm` for the offline test harness.
#
# Behaviour is driven by MOCK_* environment variables. Every invocation is
# appended to $MOCK_CALL_LOG so tests can assert which commands ran.
# Mutating commands (shutdown/stop/start) persist the new power state under
# $MOCK_RUNTIME so a pre-sleep -> post-wake sequence behaves realistically.

set -uo pipefail

mock_env() {
    local name="$1" def="${2:-}"
    if [[ -n "${!name+x}" ]]; then printf '%s' "${!name}"; else printf '%s' "$def"; fi
}

log_call() {
    [[ -n "${MOCK_CALL_LOG:-}" ]] && printf 'qm %s\n' "$*" >> "$MOCK_CALL_LOG"
    return 0
}

get_status() {
    # NB: separate statements — `local a=$1 b=$a` expands $a before it is set.
    local id="$1"
    local f="${MOCK_RUNTIME:-}/qm_status_$id"
    if [[ -f "$f" ]]; then cat "$f"; else mock_env "MOCK_QM_STATUS_$id" stopped; fi
}

set_status() {
    [[ -n "${MOCK_RUNTIME:-}" ]] && printf '%s' "$2" > "$MOCK_RUNTIME/qm_status_$1"
    return 0
}

# parse_guest_output() expects the out-data value to carry literal \r\n escape
# sequences (backslash r, backslash n), not real newlines.
emit_guest_json() {
    local escaped
    escaped=$(printf '%s' "$1" | sed ':a;N;$!ba;s/\n/\\r\\n/g')
    printf '{"exitcode":0,"exited":1,"out-data":"%s"}\n' "$escaped"
}

log_call "$@"

cmd="${1:-}"; shift || true

case "$cmd" in
    status)
        # Real `qm status` fails for an ID that does not exist; validate_config
        # relies on that, so the suite needs a way to express it.
        if [[ ",${MOCK_MISSING_IDS:-}," == *",${1:-},"* ]]; then
            echo "Configuration file 'nodes/test/qemu-server/${1:-}.conf' does not exist" >&2
            exit 2
        fi
        printf 'status: %s\n' "$(get_status "${1:-}")"
        ;;

    guest)
        sub="${1:-}"; shift || true
        case "$sub" in
            cmd)
                id="${1:-}"; action="${2:-}"
                if [[ "$action" == "ping" ]]; then
                    [[ "$(mock_env "MOCK_QM_AGENT_$id" 1)" == "1" ]] || exit 1
                fi
                exit 0
                ;;
            exec)
                id="${1:-}"; shift || true
                [[ "$(mock_env "MOCK_QM_AGENT_$id" 1)" == "1" ]] || exit 1
                script="$*"
                case "$script" in
                    *"shutdown /h"*)
                        # Hibernation succeeds unless the test disables it.
                        if [[ "$(mock_env "MOCK_VM_HIBERNATE_WORKS_$id" 1)" == "1" ]]; then
                            set_status "$id" stopped
                        fi
                        emit_guest_json ""
                        ;;
                    *nvidia-smi*)
                        emit_guest_json "$(mock_env "MOCK_VM_GPU_$id" 0)"
                        ;;
                    *"GPU Engine"*)
                        emit_guest_json "$(mock_env "MOCK_VM_GPU_AMD_$id" -1)"
                        ;;
                    *idle_seconds*)
                        emit_guest_json "$(mock_env "MOCK_VM_IDLE_$id" 99999)"
                        ;;
                    *ScreenStatus*)
                        emit_guest_json "$(mock_env "MOCK_VM_SCREENSAVER_$id" -1)"
                        ;;
                    *Get-Process*)
                        emit_guest_json "$(mock_env "MOCK_VM_PROCS_$id" "")"
                        ;;
                    *powercfg*)
                        emit_guest_json "$(mock_env "MOCK_VM_POWERREQ_$id" NONE)"
                        ;;
                    *)
                        emit_guest_json ""
                        ;;
                esac
                ;;
            *)
                exit 0
                ;;
        esac
        ;;

    shutdown)
        id="${1:-}"
        rc=$(mock_env "MOCK_QM_SHUTDOWN_RC_$id" 0)
        [[ "$rc" == "0" ]] && set_status "$id" stopped
        exit "$rc"
        ;;

    stop)
        id="${1:-}"
        set_status "$id" stopped
        exit "$(mock_env "MOCK_QM_STOP_RC_$id" 0)"
        ;;

    start)
        id="${1:-}"
        rc=$(mock_env "MOCK_QM_START_RC_$id" 0)
        [[ "$rc" == "0" ]] && set_status "$id" running
        exit "$rc"
        ;;

    *)
        exit 0
        ;;
esac
