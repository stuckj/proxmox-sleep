#!/bin/bash
#
# Mock `systemctl`. `suspend` is recorded in the call log instead of actually
# suspending the machine running the tests.
#
# `is-active [--quiet] <unit>` follows the real command: it prints the unit's
# state (unless --quiet) and exits 0 only for "active". Units are listed,
# comma-separated, in
#   MOCK_ACTIVE_UNITS      active: a running simple service
#   MOCK_ACTIVATING_UNITS  activating, exit 3: a oneshot service while it runs
# and anything else is inactive, exit 3. Measured on systemd 252 (Proxmox
# 8.4): a running Type=oneshot unit reports "activating" with exit status 3.

set -uo pipefail

[[ -n "${MOCK_CALL_LOG:-}" ]] && printf 'systemctl %s\n' "$*" >> "$MOCK_CALL_LOG"

cmd="${1:-}"

in_list() { # unit list
    local a
    IFS=',' read -ra items <<< "$2"
    for a in "${items[@]}"; do
        [[ "$(echo "$a" | xargs)" == "$1" ]] && return 0
    done
    return 1
}

case "$cmd" in
    is-active)
        unit="" quiet=0
        for arg in "$@"; do
            case "$arg" in
                is-active) ;;
                --quiet|-q) quiet=1 ;;
                *) unit="$arg" ;;
            esac
        done
        state=inactive rc=3
        if in_list "$unit" "${MOCK_ACTIVE_UNITS:-}"; then
            state=active rc=0
        elif in_list "$unit" "${MOCK_ACTIVATING_UNITS:-}"; then
            state=activating
        fi
        (( quiet )) || echo "$state"
        exit "$rc"
        ;;
    suspend)
        exit 0
        ;;
    *)
        exit 0
        ;;
esac
