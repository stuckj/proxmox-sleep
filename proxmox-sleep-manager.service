[Unit]
Description=Proxmox Sleep Manager - Hibernate VMs and stop containers on sleep
Before=sleep.target
# NVIDIA's units freeze the driver; a container still using the GPU then hangs
# in the kernel and cannot be stopped. sleep.target alone does not order them.
Before=nvidia-suspend.service nvidia-hibernate.service nvidia-suspend-then-hibernate.service
StopWhenUnneeded=yes

[Service]
Type=oneshot
RemainAfterExit=yes
SyslogIdentifier=proxmox-sleep-manager
# Give hibernation time to complete (default systemd timeout is too short)
TimeoutStopSec=600
ExecStart=/usr/local/bin/proxmox-sleep-manager.sh pre-sleep
ExecStop=/usr/local/bin/proxmox-sleep-manager.sh post-wake

[Install]
WantedBy=sleep.target
